# Optional settings for the EarthTrend API. All variables use the EARTHTREND_ prefix.
# Copy to .env (never commit it). No key is needed to run: the Earth Time Machine falls back to written-from-the-numbers
# reports when no Groq key is set.

# Origins allowed to call the API from a browser (comma-separated or JSON list).
EARTHTREND_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000,http://127.0.0.1:3000

# Upload limits.
EARTHTREND_MAX_UPLOAD_MB=25
EARTHTREND_MAX_ROWS=2000000
EARTHTREND_MAX_DATASETS=25

# Paths (defaults are relative to the backend folder).
# EARTHTREND_DEMO_CSV_PATH=data/earth_science_trend_demo.csv
# EARTHTREND_UPLOAD_DIR=data/uploads

# --- Earth Explorer -------------------------------------------------------------------------
# Natural Earth files: run `python scripts/fetch_natural_earth.py` once (about 88 MB unpacked).
# EARTHTREND_GEO_DATA_DIR=data/naturalearth
# Build the Natural Earth index in the background at start-up (about 5 s).
# EARTHTREND_GEO_WARM_ON_START=true

# Live geocoding uses OpenStreetMap Nominatim. Its usage policy requires an identifying User-Agent,
# at most 1 request per second and cached results; do not put personal details in the user agent.
# Set EARTHTREND_GEOCODER_ENABLED=false to work fully offline (the bundled reference atlas is still searched).
# EARTHTREND_GEOCODER_ENABLED=true
# EARTHTREND_NOMINATIM_URL=https://nominatim.openstreetmap.org
# EARTHTREND_GEOCODER_USER_AGENT=geo-explorer-dev/0.1 (local development)
# EARTHTREND_GEOCODER_MIN_INTERVAL_S=1.1
# EARTHTREND_GEOCODER_CACHE_TTL_S=86400

# Elevation sampling reads the same Terrarium tiles the map displays.
# EARTHTREND_TERRAIN_TILE_URL=https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png

# --- NASA data pipeline ---
# Folder for original NASA files and derived data. Must not be on the system drive.
EARTHTREND_NASA_DATA_DIR=D:
asa_data
# Earthdata Login credentials: set these in your shell or user environment, NOT in this file or in chat.
# EARTHDATA_USERNAME=
# EARTHDATA_PASSWORD=
# or: EARTHDATA_TOKEN=

# --- Earth Time Machine ---------------------------------------------------------------------
# Optional Groq key (read from the environment only; never sent to the browser or logged). Without it, explanations and
# chat answers are generated directly from the measured results.
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# India Historical Atlas root and the folder of explorer datasets (defaults shown; paths are relative to the repository root).
# EARTHTREND_ATLAS_DIR=datasets/india_historical_atlas
# EARTHTREND_EXPLORER_DIR=datasets/india_historical_atlas/processed
# Generate the old small demo lakes into an empty explorer folder (off by default).
# EARTHTREND_EXPLORER_GENERATE_DEMO=false
